# ============ 敏感文件保护 ============
# 环境变量（包含密钥、密码、个人 token）
.env
.env.*
!.env.example

# 数据库文件（SQLite、MS Access、本地缓存 DB）
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sql
# Prisma 特定路径
prisma/*.db
prisma/**/*.db
prisma/migrations_lock.toml

# 参考项目代码（往期项目、设计文档等，仅作本地参考，不纳入版本管理）
reference/

# 测试脚本（可能包含敏感数据）
test-api.ts
typecheck_log.txt

# IDE / 编辑器个人设置
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.fleet
.idea

