generator client {
  provider = "prisma-client"
  output   = "../server/lib/generated"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  password     String
  nickname     String?  // 昵称（显示名），可选
  email        String?  // 邮箱，可选
  avatar       String?  // 头像 URL，可选
  teamId       String?
  role         String   @default("individual") // system_admin / admin / subaccount / debater / individual
  mode         String   @default("individual")
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  team              Team?             @relation(fields: [teamId], references: [id])
  adminOfTeams      Team[]            @relation("TeamAdmin") // 用户作为管理员管理的团队
  teamMemberships   TeamMember[]
  standaloneMatches StandaloneMatch[]
  loginSessions     UserLoginSession[]
  timerProjects     DebateTimerProject[]
  registrations     Registration[]    // 用户提交的报名记录

  @@index([role, mode]) // 管理员列表按 role+mode 过滤（如个人用户列表）避免全表扫描
}

model Team {
  id           String   @id @default(uuid())
  name         String
  adminId      String
  admin        User     @relation("TeamAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  mode         String
  botAppId     String?
  botAppSecret String?
  botChannelId String?
  botIsPrivate Boolean?   @default(false) // 机器人公私域：true=私域(仅频道主可用/全量消息), false/null=公域
  apiToken     String?  @unique // WorkBuddy 自动化服务令牌：自动化用 Bearer <apiToken> 调用 /dispatch* 端点
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members     TeamMember[]
  tournaments Tournament[]
  users       User[]
  arenas      BotArena[] // Bot 赛场列表
  scheduledPosts ScheduledPost[] // 定时发布任务
}

// ════════════════════════════════════════════════════
// Bot 赛场 — 管理 QQ 频道内的辩论赛场
// ════════════════════════════════════════════════════
model BotArena {
  id          String   @id @default(uuid())
  teamId      String
  name        String   @default("") // 赛场名称（自定义，必填，≤8字）；同时作为 QQ 身份组前缀
  matchFormat String   @default("4v4") // 比赛形式：4v4 / 3v3 / 2v2
  originalChannelName String? // 赛场创建前的原语音子频道名；比赛期间频道被改为「赛场名 比赛形式辩论」，结束后还原。运行时由 prisma.ts 启动 ALTER 加列，代码用 raw SQL 读写。
  status      String   @default("active") // active / closed
  guildId     String?  // QQ 频道 ID（赛场所在频道）
  channelId   String?  @unique // QQ 子频道 ID（消息来源频道，一个子频道只能绑定一个赛场）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team  Team           @relation(fields: [teamId], references: [id])
  roles BotArenaRole[] // 赛场内所有身份组

  @@index([teamId])
  @@index([teamId, status])
  @@index([guildId, status])
}

// ════════════════════════════════════════════════════
// Bot 赛场身份组 — 赛场内的身份和 QQ 频道身份组映射
// ════════════════════════════════════════════════════
model BotArenaRole {
  id          String   @id @default(uuid())
  arenaId     String
  label       String   // 身份标签：正方一辩、反方二辩、评委、观众
  side        String   // 阵营：affirmative / negative / judge / audience
  orderIndex  Int      @default(0) // 发言顺序
  qqRoleId    String?  // QQ 频道身份组 ID（创建后回填）
  maxCount    Int      @default(1) // 该身份最多可认领人数
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  arena  BotArena       @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  claims BotArenaClaim[] // 认领记录

  @@index([arenaId])
  @@index([qqRoleId])
}

// ════════════════════════════════════════════════════
// Bot 身份认领记录 — 记录谁认领了哪个身份
// ════════════════════════════════════════════════════
model BotArenaClaim {
  id        String   @id @default(uuid())
  arenaId   String   // 赛场 ID（冗余字段，方便查询）
  roleId    String
  userId    String   // QQ 用户 ID
  username  String   // QQ 用户名
  guildId   String   // QQ 频道 ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role  BotArenaRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([arenaId, roleId, userId]) // 同一赛场同一身份只能认领一次
  @@index([arenaId])
  @@index([userId])
}

// ════════════════════════════════════════════════════
// Bot 权限操作日志 — 记录所有权限变更，确保可追溯
// ════════════════════════════════════════════════════
model BotPermissionLog {
  id         String   @id @default(uuid())
  teamId     String   // 团队 ID
  guildId    String   // QQ 频道 ID
  channelId  String   // 子频道 ID
  action     String   // 操作类型：ROUND_SWITCH_ALLOW / ROUND_SWITCH_DENY / AUDIENCE_SPEAK_GRANT / AUDIENCE_SPEAK_REVOKE / RESET_ALL
  targetType String   // 目标类型：role / user
  targetId   String   // 目标 ID（身份组 ID 或用户 ID）
  targetName String   // 目标名称（身份组标签或用户名）
  operator   String   // 操作者：system / timer_system / admin / auto_timer
  detail     String   // 操作详情描述
  createdAt  DateTime @default(now())

  @@index([teamId])
  @@index([teamId, createdAt])
  @@index([action])
}

// ════════════════════════════════════════════════════
// 评委评分记录 — 多维评分 + 评分理由
// ════════════════════════════════════════════════════
model MatchScore {
  id            String   @id @default(uuid())
  matchId       String   // 比赛 ID
  tournamentId  String   // 赛事 ID（冗余，方便查询）
  judgeName     String   // 评委姓名
  dimensions    String   // 评分维度 JSON：[{"name":"逻辑","score":8},{"name":"表达","score":7}]
  reason        String?  // 评分理由
  scoreTeamA    Int      // A队总分
  scoreTeamB    Int      // B队总分
  winner        String   // 评委认为胜方：teamA / teamB / draw
  bestDebaterA  String?  // A队最佳辩手
  bestDebaterB  String?  // B队最佳辩手
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  match      Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([matchId, judgeName]) // 同一评委对同一比赛只能评一次
  @@index([matchId])
  @@index([tournamentId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team            Team                  @relation(fields: [teamId], references: [id])
  user            User                  @relation(fields: [userId], references: [id])
  assignedMatches MemberAssignedMatch[]

  @@unique([teamId, userId])
}

model Tournament {
  id              String    @id @default(uuid())
  teamId          String
  name            String
  description     String?
  // 赛制：single_elimination / double_elimination / round_robin / page_playoff / swiss / group_knockout / manual
  // 注意：与 server/utils/bracket-generator.ts 中 TournamentFormat 常量保持一致
  format          String    @default("single_elimination")
  status          String    @default("pending")
  scheduledAt     DateTime?
  venue           String?

  // ====== 新增：辩论赛特有配置 ======
  groupCount        Int?    // 分组数（小组赛用，例 2 → A组 B组）
  promotePerGroup   Int?    // 每组晋级数
  topicPool         String? // 辩题库（JSON数组：["辩题1","辩题2",...]）
  bestDebaterMode   String  @default("both") // "both" 双方各一位 / "winner_only" 仅胜方
  assignments       String? // 抽签结果缓存（JSON：{ groupAssignments, topicAssignments, sides }）
  // ====================================

  // ====== 新增：报名系统配置 ======
  registrationOpen     Boolean   @default(false) // 是否开放报名
  registrationDeadline DateTime?                  // 报名截止时间
  isPublic             Boolean   @default(false) // 是否公开（允许免登录报名）
  registrationType     String    @default("both") // 报名类型：individual(仅个人) | team(仅队伍) | both(个人+队伍)
  teamSize             Int?                       // 队伍人数要求（如 4v4 → 4）
  registrationInfo     String?   // 报名须知/说明文本
  defaultFieldsConfig  String?   // 默认字段配置（JSON）：控制姓名、电话等默认字段的显示/必填/适用类型
  // =================================

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team              Team                @relation(fields: [teamId], references: [id])
  teams             TournamentTeam[]
  judges            TournamentJudge[]
  matches           Match[]
  timerTemplate     TimerTemplate?
  timerProject      DebateTimerProject? // 关联到计时器配置项目
  scores            MatchScore[]        // 评委评分记录
  registrations     Registration[]      // 报名记录
  regFields         RegistrationField[] // 自定义报名字段
  topicVotes        TopicVote[]         // 辩题投票
  debateTopics      DebateTopic[]       // 辩题库（赛事级，供辩题投票拉取候选辩题）
  questionnaires    Questionnaire[]     // 通用问卷：报名、投票、签到、反馈等统一入口
}

model TournamentTeam {
  id           String @id @default(uuid())
  tournamentId String
  name         String
  groupLabel   String? // 分组标签（如 A组 / B组）—— 抽签后写入
  seed         Int?    // 种子编号（用于淘汰赛排序）
  // ====== 新增：积分与排名 ======
  points      Int  @default(0)
  wins        Int  @default(0)
  draws       Int  @default(0)
  losses      Int  @default(0)
  scoreFor    Int  @default(0)
  scoreAgainst Int @default(0)
  // ==================================

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([tournamentId, points])
  @@index([tournamentId, groupLabel, points])
}

model TournamentJudge {
  id           String @id @default(uuid())
  tournamentId String
  name         String

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

// ════════════════════════════════════════════════════
// 辩题投票系统 — 赛前从候选辩题池投票选定辩题
// 支持赛事级（matchId=null）与场次级（关联某场 Match）两层粒度
// 投票主体：参赛辩手 / 评委 / 团队管理员 / 公开投票
// ════════════════════════════════════════════════════

// 辩题投票主表（一次投票会话）
model TopicVote {
  id            String    @id @default(uuid())
  tournamentId  String
  matchId       String?   // 关联单场比赛；null 表示赛事级投票
  title         String    // 投票标题
  description   String?   // 投票说明
  topics        String    // JSON 数组：候选辩题列表 ["辩题1","辩题2",...]
  status        String    @default("open") // draft | open | closed
  allowedVoters String?   // JSON: 允许的投票者类型，如 ["debater","judge","admin","public"]；null 视为全部允许
  multipleChoice Boolean   @default(false) // 是否允许多选
  deadline      DateTime? // 投票截止时间
  showResults   Boolean   @default(true) // 是否向投票者展示实时统计
  createdBy     String?   // 创建人 userId
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tournament Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  match      Match?           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  records    TopicVoteRecord[]

  @@index([tournamentId])
  @@index([matchId])
  @@index([tournamentId, status])
}

// 辩题投票记录（每个投票者对某次投票的选票）
model TopicVoteRecord {
  id               String   @id @default(uuid())
  voteId           String
  topicIndices     String   // JSON 数组：选中的辩题索引列表，如 "[0]" 或 "[0,2]"
  userId           String?  // 登录用户 ID（公开投票时为 null）
  voterType        String   // debater | judge | admin | public
  voterName        String?  // 公开投票时的标识/昵称
  voterFingerprint String?  // 公开投票防刷标识（IP+UA 哈希）
  createdAt        DateTime @default(now())

  vote TopicVote @relation(fields: [voteId], references: [id], onDelete: Cascade)

  @@unique([voteId, userId])
  @@index([voteId])
}

// ════════════════════════════════════════════════════
// 辩题库 — 赛事级辩题库，供辩题投票问卷拉取候选辩题
// 每个辩题包含正方立场与反方立场，投票时按"分正方双方"呈现
// ════════════════════════════════════════════════════
model DebateTopic {
  id            String   @id @default(uuid())
  tournamentId  String
  affirmative  String   // 正方立场（如"人工智能利大于弊"）
  negative     String   // 反方立场（如"人工智能弊大于利"）
  category     String?  // 分类/标签（如"政策辩""价值辩"），可选
  note         String?  // 备注说明，可选
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

// ════════════════════════════════════════════════════
// 通用问卷系统 — 报名、投票、签到、反馈等场景共用
// 说明：
// - 现有 Registration / TopicVote 继续保留业务字段，保证兼容当前流程
// - Questionnaire 作为统一索引层，记录“这是一份什么问卷”
// - QuestionnaireQuestion 统一记录题目/字段定义
// - QuestionnaireSubmission 统一记录提交索引，便于后续统一统计、导出、审计
// ════════════════════════════════════════════════════

model Questionnaire {
  id           String   @id @default(uuid())
  tournamentId String
  sourceType   String   // registration | topic_vote | checkin | feedback | match_score
  sourceId     String   // registration 使用 tournamentId；topic_vote 使用 TopicVote.id
  title        String
  description  String?
  status       String   @default("draft") // draft | open | closed
  settings     String?  // JSON：开放范围、截止时间、公开性、展示结果等配置
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament  Tournament                @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  questions   QuestionnaireQuestion[]
  submissions QuestionnaireSubmission[]

  @@unique([tournamentId, sourceType, sourceId])
  @@index([tournamentId])
  @@index([sourceType, sourceId])
  @@index([tournamentId, sourceType])
  @@index([tournamentId, status])
}

model QuestionnaireQuestion {
  id              String   @id @default(uuid())
  questionnaireId String
  fieldKey        String
  title           String
  questionType    String   // text | textarea | radio | checkbox | select | number | date | phone | email | members | heading | divider | scale
  options         String?  // JSON：选择题选项
  required        Boolean  @default(false)
  sortOrder       Int      @default(0)
  visibilityRule  String?  // JSON：适用报名类型、角色范围等显示规则
  meta            String?  // JSON：占位文本、说明、宽度、系统字段标识等扩展信息
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@index([questionnaireId])
  @@index([questionnaireId, sortOrder])
}

model QuestionnaireSubmission {
  id              String   @id @default(uuid())
  questionnaireId String
  sourceType      String   // registration | topic_vote | checkin | feedback | match_score
  sourceId        String   // 对应业务提交记录 ID：Registration.id / TopicVoteRecord.id
  respondentUserId String?
  respondentName   String?
  answers         String   // JSON：统一答案快照
  meta            String?  // JSON：报名类型、投票者类型、来源 IP 指纹等扩展信息
  submittedAt     DateTime @default(now())

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
  @@index([questionnaireId])
  @@index([respondentUserId])
  @@index([submittedAt])
}

model Match {
  id                String    @id @default(uuid())
  tournamentId      String?
  standaloneMatchId String?
  round             String
  orderNum          Int
  teamA             String?
  teamB             String?
  winner            String?
  scoreA            Int       @default(0)
  scoreB            Int       @default(0)
  status            String    @default("pending")
  scheduledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // ====== 新增：辩论赛特有字段 ======
  topic           String? // 当前比赛的辩题（由抽签分配）
  affirmativeSide String? // "teamA" | "teamB" —— 哪支队伍是正方
  bestDebaterA    String? // 正方最佳辩手（姓名或标识）
  bestDebaterB    String? // 反方最佳辩手
  judge          String? // 评委姓名（本次比赛的评委）
  // ====== 新增：版本控制与软删除 ======
  version        Int       @default(1)
  deletedAt      DateTime?
  deletedBy      String?
  deleteReason   String?
  // ====== 新增：晋级溯源 ======
  promotedFromA  String?   // teamA 来自哪场比赛的胜者（Match.id）
  promotedFromB  String?   // teamB 来自哪场比赛的胜者（Match.id）
  isBye          Boolean   @default(false)
  // =====================================

  tournament      Tournament?           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  standaloneMatch StandaloneMatch?      @relation(fields: [standaloneMatchId], references: [id], onDelete: Cascade)
  assignedMembers MemberAssignedMatch[]
  timer           Timer?
  scores          MatchScore[] // 评委评分记录
  topicVotes      TopicVote[] // 辩题投票（场次级）

  @@index([tournamentId])
  @@index([standaloneMatchId])
  @@index([tournamentId, round, orderNum])
  @@index([tournamentId, status])
  @@index([tournamentId, deletedAt])
  @@index([standaloneMatchId, deletedAt])
}

model StandaloneMatch {
  id          String    @id @default(uuid())
  userId      String
  name        String
  description String?
  venue       String?
  status      String    @default("pending")
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  matches Match[]
  timerProject DebateTimerProject?
  timerTemplate TimerTemplate?

  @@index([userId])
}

model Timer {
  id           String   @id @default(uuid())
  matchId      String?  @unique
  matchType    String
  topicPro     String
  topicCon     String
  phases       String
  currentPhase Int      @default(0)
  proRemaining Int      @default(0)
  conRemaining Int      @default(0)
  proRunning   Boolean  @default(false)
  conRunning   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  match Match? @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

model MemberAssignedMatch {
  id        String   @id @default(uuid())
  memberId  String
  matchId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  match  Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([memberId, matchId])
  @@index([memberId])
  @@index([matchId])
}

model TimerTemplate {
  id               String   @id @default(uuid())
  tournamentId     String?  @unique
  standaloneMatchId String?  @unique
  phases           String   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tournament     Tournament?     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  standaloneMatch StandaloneMatch? @relation(fields: [standaloneMatchId], references: [id], onDelete: Cascade)
}

model UserLoginSession {
  id           String   @id @default(uuid())
  userId       String
  tokenVersion Int
  deviceInfo   String   // 浏览器/设备信息（如 "Chrome on Windows"）
  ipAddress    String?
  userAgent    String?
  isActive     Boolean  @default(true)  // 当前会话是否仍有效
  loggedInAt   DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  loggedOutAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
}

// ==================== 辩论赛计时器 ====================
// 计时器项目：存储比赛配置（标题、队伍、辩题、环节列表）
model DebateTimerProject {
  id               String            @id @default(uuid())
  userId           String
  tournamentId     String?           @unique // 关联到赛事（tournaments 中的配置，一对一）
  standaloneMatchId String?          @unique // 关联到独立赛事（standalone-matches 中的配置，一对一）
  name             String            // 项目名称（后台管理用）
  title            String            // 比赛标题（显示用，如"三社联合辩论赛"）
  positiveTopic    String?           // 正方辩题
  negativeTopic    String?           // 反方辩题
  teamPositiveName String?           // 正方队伍名称
  teamNegativeName String?           // 反方队伍名称
  uiConfig         String?           // JSON 字符串的 UI 配置（界面元素样式）
  skinConfig       String?           // JSON 字符串的背景配置（背景类型、图片路径等）
  audioConfig      String?           // JSON 字符串的提示音配置（自定义提示音文件路径）
  teamLogoConfig   String?           // JSON 字符串的队徽配置（队伍Logo图片路径）
  stages           DebateTimerStage[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament     Tournament?     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  standaloneMatch StandaloneMatch? @relation(fields: [standaloneMatchId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tournamentId])
  @@index([standaloneMatchId])
}

// 计时器环节：每个项目包含多个环节
model DebateTimerStage {
  id               String   @id @default(uuid())
  projectId        String
  name             String   // 环节名称
  duration         Int      // 主时长（秒）；单方发问 = questionDuration + answerDuration
  type             String   // 环节类型，统一用新枚举值（normalizeStageType 映射后）：single_speech | single_question | summary | bilateral_debate | free_debate | single_timer | double_timer | no_timer | ppt_replace
  description      String?  // 管理员笔记，不显示给辩手
  orderIndex       Int      // 排序顺序
  positiveDuration Int?     // 双计时器：正方时长
  negativeDuration Int?     // 双计时器：反方时长
  allowedRoles     String?  // JSON 字符串：允许的角色/选手
  // ====== 角色字段（单方发言/发问/对辩）======
  speaker          String?  // 单方发言的发言方，如 "正方 · 一辩"
  speakerMode      Int?     @default(0) // 0=正常模式 1=反向/排除模式（选中值=被排除的辩手）
  questioner       String?  // 单方发问的发问人
  questionerMode   Int?     @default(0) // 同上
  responder        String?  // [已废弃] 单方发问的接受人（单值；多接盘请用 responders）
  responders       String?  // JSON: ["正方 · 一辩","反方 · 二辩",...] — 单方发问的接受人（多选）
  respondersMode   Int?     @default(0) // 同上
  firstSpeaker     String?  // 双边对辩/自由辩论的率先发言方
  protectionTime   Int?     // 保护时间（秒），0/null 表示不启用。单方发问：接受人开头 N 秒不可被打断
  // ====== 对辩双方参与辩手（多选，JSON 数组）======
  positiveSpeakers String?  // JSON: ["正方 · 一辩","正方 · 二辩",...]
  negativeSpeakers String?  // JSON: ["反方 · 一辩","反方 · 二辩",...]
  // ====== 单方发问拆分时长 ======
  questionDuration Int?     // 提问时长（秒）
  answerDuration   Int?     // 回答时长（秒）
  // ====== 环节启用开关 ======
  enabled          Boolean  @default(true) // false 时该环节在计时流程中被跳过
  // ====== 无计时器环节的发言方（用于发言权限联动）======
  // JSON 数组字符串，存可发言角色 label 列表，如 ["正方一辩","反方二辩"]
  // 单方发言/发问/对辩环节由 speaker/questioner/firstSpeaker 推导，无需本字段
  speakers         String?  // 无计时器环节的可发言角色（multi-select，角色 label）
  // ====== PPT/图片展示环节的图片（用于「PPT平替」展示，纯播报不计时）======
  // 存储上传到 /uploads/images/ 的相对路径，如 "/uploads/images/abc.png"
  pptImage         String?  // PPT/图片环节展示的图片路径；空表示不展示图片
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project DebateTimerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ════════════════════════════════════════════════════
// 报名系统 — 支持个人报名与队伍报名
// ════════════════════════════════════════════════════

// 报名记录主表
model Registration {
  id            String    @id @default(uuid())
  tournamentId  String
  type          String    // "individual" | "team"
  status        String    @default("pending") // "pending" | "approved" | "rejected"
  userId        String?   // 关联登录用户（免登录报名时为 null）
  teamName      String?   // 队伍报名时的队伍名称
  submitterName String    // 报名提交人姓名
  contactPhone  String    // 联系电话
  contactEmail  String?   // 联系邮箱
  notes         String?   // 报名备注
  customData    String?   // JSON: 自定义字段数据 { "fieldKey": "value", ... }
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reviewedAt    DateTime? // 审核时间
  reviewedBy    String?   // 审核人 userId
  reviewNote    String?   // 审核备注
  convertedTeamId String? // 审核通过后转为参赛队伍的 TournamentTeam.id
  accountCreated Boolean  @default(false) // 是否已为辩手创建子账号

  tournament Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  // 用户被删除时，保留报名记录（用于审计），仅解除关联
  user       User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  members    RegistrationMember[]

  @@index([tournamentId])
  @@index([tournamentId, status])
  @@index([tournamentId, type])
  @@index([userId])
}

// 报名成员（个人报名 = 1人，队伍报名 = N人）
model RegistrationMember {
  id              String   @id @default(uuid())
  registrationId  String
  name            String   // 成员姓名
  preferredPosition String? // preferred 辩位：一辩/二辩/三辩/四辩/不限
  experience      String?   // 辩论经验描述
  userId          String?   // 创建子账号后的系统用户 ID
  createdAt       DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
}

// 报名表单字段配置（统一存储所有字段：系统字段 + 自定义字段）
model RegistrationField {
  id           String   @id @default(uuid())
  tournamentId String
  fieldName    String   // 字段显示名称（中文标签）
  fieldKey     String   // 字段键名（英文标识，用于数据存储与映射）
  // 字段类型：text | textarea | select | checkbox | radio | number | date | phone | email | members | divider | heading
  fieldType    String   @default("text")
  fieldOptions String?  // JSON: 选项列表（select/radio/checkbox 用）
  required     Boolean  @default(false)
  sortOrder    Int      @default(0)
  appliesTo    String   @default("both") // individual | team | both
  // ── 新增：表单设计器属性 ──
  placeholder  String?  // 占位提示文本
  description  String?  // 字段描述/帮助文字
  width        String   @default("full") // "half"（半宽） | "full"（全宽）
  // ── 新增：系统字段标识 ──
  // systemField=true 表示系统内置字段（submitterName/contactPhone/contactEmail/teamName/members/notes）
  // 系统字段不可删除、不可修改 fieldKey/fieldType，但可调整显示名、必填、适用类型等
  systemField  Boolean  @default(false)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

// ════════════════════════════════════════════════════

// 定时发布任务 — 定时向 QQ 频道「论坛」子频道发布辩论题目/讨论帖
// 说明：
// - 论坛发帖仅私域机器人可用（与 bot-ws 域隔离约束一致）
// - 调度类型：once(单次) / daily(每天) / weekly(每周)；monthly 等留作升级
// - 时间统一以 UTC 存储，展示时按 timezone 还原
// ════════════════════════════════════════════════════
model ScheduledPost {
  id          String   @id @default(uuid())
  teamId      String
  title       String
  content     String   // Markdown 正文
  type        String   @default("discussion") // 'debate'（辩论题目） | 'discussion'（讨论话题）
  channelId   String   // 目标论坛子频道 ID
  tags        String?  // 逗号分隔标签，如 "辩题,本周"
  pollOptions String?  // JSON 数组：投票选项 ["A队","B队"]
  // 调度配置
  scheduleType String  @default("once") // 'once' | 'daily' | 'weekly'
  runAt       DateTime? // 'once'：本地触发时间（存储为 UTC）
  timeHHMM    String?  // 'daily'/'weekly'：本地时间 "HH:mm"
  weekday     Int?     // 'weekly'：星期几 0-6（0=周日）
  timezone    String   @default("Asia/Shanghai")
  status      String   @default("pending") // pending(待发布) | published(已发布·单次完成) | paused(已暂停) | failed(失败)
  lastRunAt   DateTime?
  lastResult  String?  // 最近一次发布结果描述
  nextRunAt   DateTime? // 下次触发时间（UTC），用于列表展示与调度扫描
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  runs ScheduledPostRun[]

  @@index([teamId])
  @@index([teamId, status, nextRunAt])
  @@index([status, nextRunAt]) // 调度扫描 scanDueTasks 按 status+nextRunAt 命中，避免全表扫描 ScheduledPost
}

// 定时发布执行历史（每次触发记一条）
model ScheduledPostRun {
  id              String   @id @default(uuid())
  scheduledPostId String
  runAt           DateTime @default(now())
  status          String   // 'success' | 'failed'
  message         String?  // 结果/错误信息
  postTaskId      String?  // QQ 论坛返回的 task_id

  scheduledPost ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)

  @@index([scheduledPostId])
}
