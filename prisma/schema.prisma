generator client {
  provider = "prisma-client"
  output   = "../server/lib/generated"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  password     String
  teamId       String?
  role         String   @default("individual") // system_admin / admin / subaccount / debater / individual
  mode         String   @default("individual")
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  team              Team?             @relation(fields: [teamId], references: [id])
  adminOfTeams      Team[]            @relation("TeamAdmin") // 用户作为管理员管理的团队
  teamMemberships   TeamMember[]
  standaloneMatches StandaloneMatch[]
  loginSessions     UserLoginSession[]
  timerProjects     DebateTimerProject[]
  registrations     Registration[]    // 用户提交的报名记录
}

model Team {
  id           String   @id @default(uuid())
  name         String
  adminId      String
  admin        User     @relation("TeamAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  mode         String
  botAppId     String?
  botAppSecret String?
  botChannelId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members     TeamMember[]
  tournaments Tournament[]
  users       User[]
  arenas      BotArena[] // Bot 赛场列表
}

// ════════════════════════════════════════════════════
// Bot 赛场 — 管理 QQ 频道内的辩论赛场
// ════════════════════════════════════════════════════
model BotArena {
  id          String   @id @default(uuid())
  teamId      String
  name        String   @default("") // 赛场名称，如"赛场A"
  matchFormat String   @default("4v4") // 比赛形式：4v4 / 3v3 / 2v2
  status      String   @default("active") // active / closed
  guildId     String?  // QQ 频道 ID（赛场所在频道）
  channelId   String?  @unique // QQ 子频道 ID（消息来源频道，一个子频道只能绑定一个赛场）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team  Team           @relation(fields: [teamId], references: [id])
  roles BotArenaRole[] // 赛场内所有身份组

  @@index([teamId])
  @@index([teamId, status])
  @@index([guildId, status])
}

// ════════════════════════════════════════════════════
// Bot 赛场身份组 — 赛场内的身份和 QQ 频道身份组映射
// ════════════════════════════════════════════════════
model BotArenaRole {
  id          String   @id @default(uuid())
  arenaId     String
  label       String   // 身份标签：正方一辩、反方二辩、评委、观众
  side        String   // 阵营：affirmative / negative / judge / audience
  orderIndex  Int      @default(0) // 发言顺序
  qqRoleId    String?  // QQ 频道身份组 ID（创建后回填）
  maxCount    Int      @default(1) // 该身份最多可认领人数
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  arena  BotArena       @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  claims BotArenaClaim[] // 认领记录

  @@index([arenaId])
  @@index([qqRoleId])
}

// ════════════════════════════════════════════════════
// Bot 身份认领记录 — 记录谁认领了哪个身份
// ════════════════════════════════════════════════════
model BotArenaClaim {
  id        String   @id @default(uuid())
  arenaId   String   // 赛场 ID（冗余字段，方便查询）
  roleId    String
  userId    String   // QQ 用户 ID
  username  String   // QQ 用户名
  guildId   String   // QQ 频道 ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role  BotArenaRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([arenaId, roleId, userId]) // 同一赛场同一身份只能认领一次
  @@index([arenaId])
  @@index([userId])
}

// ════════════════════════════════════════════════════
// Bot 权限操作日志 — 记录所有权限变更，确保可追溯
// ════════════════════════════════════════════════════
model BotPermissionLog {
  id         String   @id @default(uuid())
  teamId     String   // 团队 ID
  guildId    String   // QQ 频道 ID
  channelId  String   // 子频道 ID
  action     String   // 操作类型：ROUND_SWITCH_ALLOW / ROUND_SWITCH_DENY / AUDIENCE_SPEAK_GRANT / AUDIENCE_SPEAK_REVOKE / RESET_ALL
  targetType String   // 目标类型：role / user
  targetId   String   // 目标 ID（身份组 ID 或用户 ID）
  targetName String   // 目标名称（身份组标签或用户名）
  operator   String   // 操作者：system / timer_system / admin / auto_timer
  detail     String   // 操作详情描述
  createdAt  DateTime @default(now())

  @@index([teamId])
  @@index([teamId, createdAt])
  @@index([action])
}

// ════════════════════════════════════════════════════
// 评委评分记录 — 多维评分 + 评分理由
// ════════════════════════════════════════════════════
model MatchScore {
  id            String   @id @default(uuid())
  matchId       String   // 比赛 ID
  tournamentId  String   // 赛事 ID（冗余，方便查询）
  judgeName     String   // 评委姓名
  dimensions    String   // 评分维度 JSON：[{"name":"逻辑","score":8},{"name":"表达","score":7}]
  reason        String?  // 评分理由
  scoreTeamA    Int      // A队总分
  scoreTeamB    Int      // B队总分
  winner        String   // 评委认为胜方：teamA / teamB / draw
  bestDebaterA  String?  // A队最佳辩手
  bestDebaterB  String?  // B队最佳辩手
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  match      Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([matchId, judgeName]) // 同一评委对同一比赛只能评一次
  @@index([matchId])
  @@index([tournamentId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team            Team                  @relation(fields: [teamId], references: [id])
  user            User                  @relation(fields: [userId], references: [id])
  assignedMatches MemberAssignedMatch[]

  @@unique([teamId, userId])
}

model Tournament {
  id              String    @id @default(uuid())
  teamId          String
  name            String
  description     String?
  // 赛制：single_elimination / double_elimination / round_robin / page_playoff / swiss / group_knockout / manual
  // 注意：与 server/utils/bracket-generator.ts 中 TournamentFormat 常量保持一致
  format          String    @default("single_elimination")
  status          String    @default("pending")
  scheduledAt     DateTime?
  venue           String?

  // ====== 新增：辩论赛特有配置 ======
  groupCount        Int?    // 分组数（小组赛用，例 2 → A组 B组）
  promotePerGroup   Int?    // 每组晋级数
  topicPool         String? // 辩题库（JSON数组：["辩题1","辩题2",...]）
  bestDebaterMode   String  @default("both") // "both" 双方各一位 / "winner_only" 仅胜方
  assignments       String? // 抽签结果缓存（JSON：{ groupAssignments, topicAssignments, sides }）
  // ====================================

  // ====== 新增：报名系统配置 ======
  registrationOpen     Boolean   @default(false) // 是否开放报名
  registrationDeadline DateTime?                  // 报名截止时间
  isPublic             Boolean   @default(false) // 是否公开（允许免登录报名）
  teamSize             Int?                       // 队伍人数要求（如 4v4 → 4）
  registrationInfo     String?   // 报名须知/说明文本
  // =================================

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team              Team                @relation(fields: [teamId], references: [id])
  teams             TournamentTeam[]
  judges            TournamentJudge[]
  matches           Match[]
  timerTemplate     TimerTemplate?
  timerProject      DebateTimerProject? // 关联到计时器配置项目
  scores            MatchScore[]        // 评委评分记录
  registrations     Registration[]      // 报名记录
  regFields         RegistrationField[] // 自定义报名字段
  topicVotes        TopicVote[]         // 辩题投票
}

model TournamentTeam {
  id           String @id @default(uuid())
  tournamentId String
  name         String
  groupLabel   String? // 分组标签（如 A组 / B组）—— 抽签后写入
  seed         Int?    // 种子编号（用于淘汰赛排序）
  // ====== 新增：积分与排名 ======
  points      Int  @default(0)
  wins        Int  @default(0)
  draws       Int  @default(0)
  losses      Int  @default(0)
  scoreFor    Int  @default(0)
  scoreAgainst Int @default(0)
  // ==================================

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([tournamentId, points])
  @@index([tournamentId, groupLabel, points])
}

model TournamentJudge {
  id           String @id @default(uuid())
  tournamentId String
  name         String

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

// ════════════════════════════════════════════════════
// 辩题投票系统 — 赛前从候选辩题池投票选定辩题
// 支持赛事级（matchId=null）与场次级（关联某场 Match）两层粒度
// 投票主体：参赛辩手 / 评委 / 团队管理员 / 公开投票
// ════════════════════════════════════════════════════

// 辩题投票主表（一次投票会话）
model TopicVote {
  id            String    @id @default(uuid())
  tournamentId  String
  matchId       String?   // 关联单场比赛；null 表示赛事级投票
  title         String    // 投票标题
  description   String?   // 投票说明
  topics        String    // JSON 数组：候选辩题列表 ["辩题1","辩题2",...]
  status        String    @default("open") // draft | open | closed
  allowedVoters String?   // JSON: 允许的投票者类型，如 ["debater","judge","admin","public"]；null 视为全部允许
  multipleChoice Boolean   @default(false) // 是否允许多选
  deadline      DateTime? // 投票截止时间
  showResults   Boolean   @default(true) // 是否向投票者展示实时统计
  createdBy     String?   // 创建人 userId
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tournament Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  match      Match?           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  records    TopicVoteRecord[]

  @@index([tournamentId])
  @@index([matchId])
  @@index([tournamentId, status])
}

// 辩题投票记录（每个投票者对某次投票的选票）
model TopicVoteRecord {
  id               String   @id @default(uuid())
  voteId           String
  topicIndices     String   // JSON 数组：选中的辩题索引列表，如 "[0]" 或 "[0,2]"
  userId           String?  // 登录用户 ID（公开投票时为 null）
  voterType        String   // debater | judge | admin | public
  voterName        String?  // 公开投票时的标识/昵称
  voterFingerprint String?  // 公开投票防刷标识（IP+UA 哈希）
  createdAt        DateTime @default(now())

  vote TopicVote @relation(fields: [voteId], references: [id], onDelete: Cascade)

  @@unique([voteId, userId])
  @@index([voteId])
}

model Match {
  id                String    @id @default(uuid())
  tournamentId      String?
  standaloneMatchId String?
  round             String
  orderNum          Int
  teamA             String?
  teamB             String?
  winner            String?
  scoreA            Int       @default(0)
  scoreB            Int       @default(0)
  status            String    @default("pending")
  scheduledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // ====== 新增：辩论赛特有字段 ======
  topic           String? // 当前比赛的辩题（由抽签分配）
  affirmativeSide String? // "teamA" | "teamB" —— 哪支队伍是正方
  bestDebaterA    String? // 正方最佳辩手（姓名或标识）
  bestDebaterB    String? // 反方最佳辩手
  judge          String? // 评委姓名（本次比赛的评委）
  // ====== 新增：版本控制与软删除 ======
  version        Int       @default(1)
  deletedAt      DateTime?
  deletedBy      String?
  deleteReason   String?
  // ====== 新增：晋级溯源 ======
  promotedFromA  String?   // teamA 来自哪场比赛的胜者（Match.id）
  promotedFromB  String?   // teamB 来自哪场比赛的胜者（Match.id）
  isBye          Boolean   @default(false)
  // =====================================

  tournament      Tournament?           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  standaloneMatch StandaloneMatch?      @relation(fields: [standaloneMatchId], references: [id], onDelete: Cascade)
  assignedMembers MemberAssignedMatch[]
  timer           Timer?
  scores          MatchScore[] // 评委评分记录
  topicVotes      TopicVote[] // 辩题投票（场次级）

  @@index([tournamentId])
  @@index([standaloneMatchId])
  @@index([tournamentId, round, orderNum])
  @@index([tournamentId, status])
  @@index([tournamentId, deletedAt])
  @@index([standaloneMatchId, deletedAt])
}

model StandaloneMatch {
  id          String    @id @default(uuid())
  userId      String
  name        String
  description String?
  status      String    @default("pending")
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  matches Match[]

  @@index([userId])
}

model Timer {
  id           String   @id @default(uuid())
  matchId      String?  @unique
  matchType    String
  topicPro     String
  topicCon     String
  phases       String
  currentPhase Int      @default(0)
  proRemaining Int      @default(0)
  conRemaining Int      @default(0)
  proRunning   Boolean  @default(false)
  conRunning   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  match Match? @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

model MemberAssignedMatch {
  id        String   @id @default(uuid())
  memberId  String
  matchId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  match  Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([memberId, matchId])
  @@index([memberId])
  @@index([matchId])
}

model TimerTemplate {
  id           String   @id @default(uuid())
  tournamentId String   @unique
  phases       String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model UserLoginSession {
  id           String   @id @default(uuid())
  userId       String
  tokenVersion Int
  deviceInfo   String   // 浏览器/设备信息（如 "Chrome on Windows"）
  ipAddress    String?
  userAgent    String?
  isActive     Boolean  @default(true)  // 当前会话是否仍有效
  loggedInAt   DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  loggedOutAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
}

// ==================== 辩论赛计时器 ====================
// 计时器项目：存储比赛配置（标题、队伍、辩题、环节列表）
model DebateTimerProject {
  id               String            @id @default(uuid())
  userId           String
  tournamentId     String?           @unique // 关联到赛事（tournaments 中的配置，一对一）
  name             String            // 项目名称（后台管理用）
  title            String            // 比赛标题（显示用，如"三社联合辩论赛"）
  positiveTopic    String?           // 正方辩题
  negativeTopic    String?           // 反方辩题
  teamPositiveName String?           // 正方队伍名称
  teamNegativeName String?           // 反方队伍名称
  uiConfig         String?           // JSON 字符串的 UI 配置（界面元素样式）
  skinConfig       String?           // JSON 字符串的背景配置（背景类型、图片路径等）
  audioConfig      String?           // JSON 字符串的提示音配置（自定义提示音文件路径）
  teamLogoConfig   String?           // JSON 字符串的队徽配置（队伍Logo图片路径）
  stages           DebateTimerStage[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament     Tournament?     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tournamentId])
}

// 计时器环节：每个项目包含多个环节
model DebateTimerStage {
  id               String   @id @default(uuid())
  projectId        String
  name             String   // 环节名称
  duration         Int      // 主时长（秒）
  type             String   // 'speech' | 'question' | 'summary' | 'special' | 'dual-timer'
  description      String?
  orderIndex       Int      // 排序顺序
  positiveDuration Int?     // 双计时器：正方时长
  negativeDuration Int?     // 双计时器：反方时长
  allowedRoles     String?  // JSON 字符串：允许的角色/选手
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project DebateTimerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ════════════════════════════════════════════════════
// 报名系统 — 支持个人报名与队伍报名
// ════════════════════════════════════════════════════

// 报名记录主表
model Registration {
  id            String    @id @default(uuid())
  tournamentId  String
  type          String    // "individual" | "team"
  status        String    @default("pending") // "pending" | "approved" | "rejected"
  userId        String?   // 关联登录用户（免登录报名时为 null）
  teamName      String?   // 队伍报名时的队伍名称
  submitterName String    // 报名提交人姓名
  contactPhone  String    // 联系电话
  contactEmail  String?   // 联系邮箱
  notes         String?   // 报名备注
  customData    String?   // JSON: 自定义字段数据 { "fieldKey": "value", ... }
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reviewedAt    DateTime? // 审核时间
  reviewedBy    String?   // 审核人 userId
  reviewNote    String?   // 审核备注
  convertedTeamId String? // 审核通过后转为参赛队伍的 TournamentTeam.id
  accountCreated Boolean  @default(false) // 是否已为辩手创建子账号

  tournament Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  // 用户被删除时，保留报名记录（用于审计），仅解除关联
  user       User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  members    RegistrationMember[]

  @@index([tournamentId])
  @@index([tournamentId, status])
  @@index([tournamentId, type])
  @@index([userId])
}

// 报名成员（个人报名 = 1人，队伍报名 = N人）
model RegistrationMember {
  id              String   @id @default(uuid())
  registrationId  String
  name            String   // 成员姓名
  preferredPosition String? // preferred 辩位：一辩/二辩/三辩/四辩/不限
  experience      String?   // 辩论经验描述
  userId          String?   // 创建子账号后的系统用户 ID
  createdAt       DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
}

// 自定义报名字段配置
model RegistrationField {
  id           String   @id @default(uuid())
  tournamentId String
  fieldName    String   // 字段显示名称（中文标签）
  fieldKey     String   // 字段键名（英文标识，用于 customData 存储）
  fieldType    String   @default("text") // text | textarea | select | checkbox | radio
  fieldOptions String?  // JSON: 选项列表（select/radio/checkbox 用）
  required     Boolean  @default(false)
  sortOrder    Int      @default(0)
  appliesTo    String   @default("both") // individual | team | both

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}
