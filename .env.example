# DebateTimerV3 环境变量配置
# 复制此文件为 .env 并填写实际值

# ── JWT 密钥（必填） ──
# 生产环境必须设置为至少 32 字符的随机字符串
JWT_SECRET=your-jwt-secret-at-least-32-chars

# ── 数据库（可选） ──
# 默认使用本地 SQLite 文件（prisma/dev.db）
# DATABASE_URL=file:./prisma/dev.db

# ── 内部 API 密钥（必填，用于计时器/Bot 后台调用 internal API） ──
# 生产环境必须修改
INTERNAL_API_KEY=your-internal-api-key

# ── Bot 配置（仅 qq_bot 模式需要） ──
# BOT_APP_ID=
# BOT_TOKEN=
# BOT_SECRET=

# ── 上传文件配置（可选） ──
# UPLOAD_DIR=./public/uploads

# ── 服务器端口（可选） ──
# 默认 3000
# PORT=3000
# NITRO_PORT=3000
